rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRoomOwner(roomId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }

    // ---------- /users/{uid} ----------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20;
      allow update: if isOwner(uid);
      allow delete: if false;

      // ---------- /users/{uid}/friendRequests/{fromUid} ----------
      // 친구 요청함: 본인(uid)에게 온 요청. 문서 id = 보낸 사람의 uid (중복 요청 방지)
      // 상대방의 온라인 여부와 무관하게 언제든 요청을 보낼 수 있음
      match /friendRequests/{fromUid} {
        allow read: if isOwner(uid) || isOwner(fromUid);
        allow create: if isOwner(fromUid)
          && request.resource.data.fromUid == fromUid
          && request.resource.data.toUid == uid;
        allow delete: if isOwner(uid) || isOwner(fromUid);
        allow update: if false;
      }

      // ---------- /users/{uid}/roomInvites/{inviteId} ----------
      // 방 초대함(팀/단체채팅 초대, 1:1 대화 신청 알림 포함): 본인(uid)이 받은 초대 목록
      match /roomInvites/{inviteId} {
        allow read: if isOwner(uid);
        allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      // ---------- /users/{uid}/myRooms/{roomId} ----------
      // 내가 참여 중인 방 미러(팀/단체/DM 사이드바 목록용). 본인만 읽고 쓸 수 있음(자기 자신에 대해서만 기록)
      match /myRooms/{roomId} {
        allow read, write: if isOwner(uid);
      }

      // ---------- /users/{uid}/unlockedRooms/{roomId} ----------
      // 비밀번호를 한 번 맞춘 방 기록 (계정별로 다음부터 비밀번호 재입력 생략)
      match /unlockedRooms/{roomId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- /friendships/{pairId} ----------
    // pairId = 정렬된 "uidA_uidB" 형태, members 배열에 두 uid 포함
    match /friendships/{pairId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    // ---------- /rooms/{roomId} ----------
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.type in ['open', 'team', 'group', 'dm'];
      // 방 정보(이름/비밀번호 해시) 수정·삭제는 방장만
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // ---------- /rooms/{roomId}/members/{uid} ----------
      match /members/{uid} {
        allow read: if isSignedIn();
        // 입장(본인이 자기 자신을 추가)은 본인만 가능 — 강제 입장 방지.
        // 단, 강퇴(banned)된 적이 있으면 재입장 불가.
        allow create: if isOwner(uid)
          && !exists(/databases/$(database)/documents/rooms/$(roomId)/banned/$(uid));
        allow update: if isOwner(uid);
        // 삭제는 본인(퇴장) 또는 방장(강퇴) 모두 가능
        allow delete: if isOwner(uid) || isRoomOwner(roomId);
      }

      // ---------- /rooms/{roomId}/banned/{uid} ----------
      // 강퇴된 사용자 명단 — 방장만 추가 가능, 재입장 차단에 사용
      match /banned/{uid} {
        allow read: if isSignedIn();
        allow write: if isRoomOwner(roomId);
      }

      // ---------- /rooms/{roomId}/messages/{messageId} ----------
      match /messages/{messageId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && (
               request.resource.data.senderUid == request.auth.uid ||
               (request.resource.data.senderUid == 'system' && request.resource.data.system == true)
             )
          && (
               !('text' in request.resource.data) ||
               request.resource.data.text == null ||
               (request.resource.data.text is string && request.resource.data.text.size() <= 4000)
             )
          && request.resource.data.createdAt == request.time;

        // 삭제는 실제 delete가 아니라 soft-delete(update)만 허용, 본인 메시지만
        allow update: if isSignedIn()
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.deleted == true;

        allow delete: if false;
      }
    }
  }
}
